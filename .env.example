# Sao chép file này thành .env.local khi chạy ở máy cá nhân. Trên Vercel: Project Settings > Environment Variables.
# Biến NEXT_PUBLIC_* được nhúng vào lúc build, nên đổi giá trị xong phải deploy lại.

# Địa chỉ gốc của website, không có dấu / ở cuối. Dùng cho canonical, Open Graph, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://ten-mien-cua-ban.com

# Website ID lấy từ Umami (Settings > Websites > Edit). Để trống thì không tải script đo traffic.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Chỉ cần khi tự host Umami. Mặc định dùng Umami Cloud: https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_SRC=
